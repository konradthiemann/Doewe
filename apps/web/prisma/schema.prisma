generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id          String        @id @default(cuid())
  name        String
  // Original creator of the account. Kept for provenance; authorization is
  // scoped by householdId (Teil D — a household is the tenant, not a user).
  userId      String
  householdId String
  createdAt   DateTime      @default(now())
  // Sync (Phase 3b): updatedAt drives conflict detection (baseUpdatedAt compare);
  // deletedAt is a tombstone so a delete propagates as a row instead of a gap.
  updatedAt   DateTime      @default(now()) @updatedAt
  deletedAt   DateTime?
  transactions Transaction[]
  recurring    RecurringTransaction[]
  budgets      Budget[]

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([householdId])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  // Original creator; authorization is scoped by householdId (Teil D).
  userId        String
  householdId   String
  isIncome      Boolean       @default(false)
  // Selecting this category in the transaction form pre-enables the tax toggle.
  isTaxRelevant Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  deletedAt     DateTime?
  transactions Transaction[]
  recurring    RecurringTransaction[]
  budgets      Budget[]

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([userId])
  @@index([householdId])
}

model Transaction {
  id            String   @id @default(cuid())
  accountId     String
  categoryId    String?
  savingGoalId  String?
  amountCents   Int
  description   String
  occurredAt    DateTime
  // Marked for the German tax return (Belegvorhaltepflicht: receipts are
  // archived as attachments and kept for the Finanzamt on request).
  taxRelevant   Boolean  @default(false)
  // Which household member booked this (Teil D) — drives the "von {Name}" badge.
  // Nullable: legacy rows are backfilled to the account's original owner; future
  // writes always set it from the session user.
  createdByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  deletedAt     DateTime?
  receiptMerchant  String?

  account     Account  @relation(fields: [accountId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  savingGoal  Budget?   @relation(fields: [savingGoalId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  receiptLineItems ReceiptLineItem[]
}

// Receipt files (photos/PDFs) attached to a transaction as tax evidence.
// `data` holds the raw bytes — never select it in list queries; only
// GET /api/attachments/[id] may load it.
model Attachment {
  id            String   @id @default(cuid())
  transactionId String
  fileName      String
  mimeType      String
  sizeBytes     Int
  data          Bytes
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

// Line items extracted from a scanned receipt. Each transaction created via
// receipt scan stores its individual positions here for transparency.
model ReceiptLineItem {
  id             String   @id @default(cuid())
  transactionId  String
  name           String
  quantity       Float    @default(1)
  unitPriceCents Int
  totalCents     Int
  position       Int
  createdAt      DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

// Note: SQLite does not support Prisma enums; use a string field with app-level validation.

model RecurringTransaction {
  id             String    @id @default(cuid())
  accountId      String
  categoryId     String?
  amountCents    Int
  description    String
  // Allowed values: DAILY | WEEKLY | MONTHLY | YEARLY (validated in API)
  frequency      String
  intervalMonths Int       @default(1)
  dayOfMonth     Int       @default(1) // Day of month (1-31) when transaction occurs
  nextOccurrence DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  account  Account   @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  skips    RecurringTransactionSkip[]
}

model RecurringTransactionSkip {
  id          String   @id @default(cuid())
  recurringId String
  year        Int
  month       Int
  createdAt   DateTime @default(now())

  recurring RecurringTransaction @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@unique([recurringId, year, month])
  @@index([recurringId])
}

model Budget {
  id          String    @id @default(cuid())
  accountId   String
  categoryId  String?
  title       String    @default("")
  // Category budgets always set month/year. Saving goals may be "undated"
  // (month/year null) — an idea backlog with no deadline.
  month       Int?      // 1-12, null = undated saving goal
  year        Int?      // null = undated saving goal
  // Required for category budgets; optional for saving goals (an idea may not
  // have a concrete target amount yet).
  amountCents Int?      // goal amount; null = no amount set yet
  completedAt DateTime? // null = active goal, set = goal closed
  spentCents  Int?      // amount actually withdrawn from savings on completion (snapshot)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  account      Account       @relation(fields: [accountId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@unique([accountId, categoryId, month, year])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  // Null for accounts created via an OAuth provider (e.g. Google) that never
  // set a local password. Credentials sign-in rejects users without a password.
  password  String?
  name      String?
  createdAt DateTime  @default(now())
  // Bumped on every password change/reset. JWTs issued before this instant are
  // treated as stale and rejected, so a reset evicts existing sessions.
  passwordChangedAt DateTime?

  // Server-rendered push texts need the language at the user (the UI locale
  // lives only client-side in localStorage). The settings language switch syncs
  // this field. Allowed: "de" | "en" (validated in the API).
  locale             String  @default("de")
  // Per-user opt-outs for the two push families (Teil C). Default on, but a push
  // is only ever sent to a user who also has at least one PushSubscription.
  notifyBudgetAlerts  Boolean @default(true)
  notifyMonthlyReview Boolean @default(true)

  accounts  Account[]
  categories Category[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  reminderSetting     ReminderSetting?
  // v1: exactly one household per user (see HouseholdMember.userId @unique).
  householdMember     HouseholdMember?
}

// Teil D — Haushalts-Sharing: the household is the tenant boundary. All
// financial data (Accounts, Categories and everything hanging off them) is
// scoped by householdId, so two users sharing a household see the same data.
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members    HouseholdMember[]
  invites    HouseholdInvite[]
  accounts   Account[]
  categories Category[]
}

// v1: one household per user (`userId @unique`) → the session carries a single
// householdId, no household switcher in the UI. role: OWNER | MEMBER.
model HouseholdMember {
  id          String   @id @default(cuid())
  householdId String
  userId      String   @unique
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// Invitation to join a household. Only the SHA-256 hash of the token is stored;
// the plaintext lives solely in the emailed/shared invite link (same pattern as
// PasswordResetToken). v1: only fresh accounts without own data may accept.
model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  email       String?
  role        String    @default("MEMBER")
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// One-time tokens for the "forgot password" flow. Only the SHA-256 hash of the
// token is stored — the plaintext lives solely in the emailed reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Idempotenz-Log für Offline-Mutationen (Phase 3a Offline-Erfassen):
// Der Client sendet je Mutation einen Idempotency-Key (mutationId). Replays
// mit bekannter mutationId geben die gespeicherte Antwort zurück, statt
// doppelt zu buchen — ein Netzabbruch NACH dem Commit ist damit ungefährlich.
// Bewusst ohne User-Relation: reines Log, kein Domain-Objekt.
model MutationLog {
  id             String   @id @default(cuid())
  mutationId     String   @unique
  userId         String
  entity         String
  responseStatus Int
  responseBody   Json
  appliedAt      DateTime @default(now())

  @@index([userId])
}

// Konflikt-Journal (Phase 3b Zwei-Wege-Sync): Sobald bei /api/sync/push ein
// Feld per Last-Write-Wins überschrieben wurde, während ein anderes Gerät
// denselben Datensatz zwischenzeitlich geändert hatte, landet der verlorene
// Wert hier. Die UI meldet das dezent ("auf einem anderen Gerät geändert").
// Reines Log, haushaltsweit scoped, keine Domain-Relation.
model ConflictLog {
  id           String   @id @default(cuid())
  householdId  String
  entity       String
  entityId     String
  field        String
  serverValue  Json
  clientValue  Json
  createdAt    DateTime @default(now())

  @@index([householdId])
}

// Web Push (Teil C): one row per browser/device that granted notification
// permission. Several devices per user; on HTTP 404/410 during delivery the
// endpoint is stale and the row is deleted. p256dh/auth are the client's
// encryption keys from the PushSubscription's getKey() output.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Dedupe for budget-threshold pushes — the unique constraint guarantees the
// same threshold for the same category-budget month is only sent once (same
// idempotency shape as RecurringTransactionSkip). budgetId is the Budget row id.
model BudgetAlertLog {
  id        String   @id @default(cuid())
  budgetId  String
  year      Int
  month     Int
  threshold Int
  sentAt    DateTime @default(now())

  @@unique([budgetId, year, month, threshold])
  @@index([budgetId])
}

// Configurable capture reminder (Teil C, 5.3). Server-side cron scheduling
// because the web has no client-side scheduled notifications. `weekdays` is a
// 7-bit bitmask (bit 0 = Sunday … bit 6 = Saturday). `time` is local wall-clock
// "HH:MM" interpreted in `timezone` (IANA). `lastSentOn` caps it to one push
// per day even across cron overlaps/restarts.
model ReminderSetting {
  id           String   @id @default(cuid())
  userId       String   @unique
  enabled      Boolean  @default(false)
  time         String   @default("20:00")
  weekdays     Int      @default(127)
  timezone     String   @default("Europe/Berlin")
  smartSuppress Boolean @default(true)
  lastSentOn   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}