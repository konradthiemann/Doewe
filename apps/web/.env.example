# DATABASE_URL="postgresql://user:password@localhost:5432/doewe_local"
# NEXTAUTH_SECRET="set-a-strong-random-secret"
# NEXTAUTH_URL="http://localhost:3000"
# SEED_USER_EMAIL="demo@doewe.test"
# SEED_USER_PASSWORD="demo1234"
# SEED_USER_NAME="Demo User"
# TEST_USER_ID_BYPASS="test-user"  # optional for local e2e or Vitest only
# --- Password reset email ---
# Transport is picked in order: SMTP (if SMTP_* set) → Resend (if key set) → console log (dev).
# NEXTAUTH_URL must be set in production so the reset link points at the right host.
#
# Option A — Gmail SMTP (sends FROM your Gmail; needs Railway Pro, 2FA + App Password):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="konrad.thiemann@gmail.com"
# SMTP_PASS="xxxxxxxxxxxxxxxx"        # 16-char Google App Password (NOT your normal password)
# EMAIL_FROM="Doewe <konrad.thiemann@gmail.com>"
#
# Option B — Resend HTTPS API (needs a verified domain; works on any Railway plan):
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="Doewe <noreply@your-domain>"