# DATABASE_URL="postgresql://user:password@localhost:5432/doewe_local"
# NEXTAUTH_SECRET="set-a-strong-random-secret"
# NEXTAUTH_URL="http://localhost:3000"
# SEED_USER_EMAIL="demo@doewe.test"
# SEED_USER_PASSWORD="demo1234"
# SEED_USER_NAME="Demo User"
# TEST_USER_ID_BYPASS="test-user"  # optional for local e2e or Vitest only
# --- Password reset email ---
# Transport is picked in order: SMTP (if SMTP_* set) → Resend (if key set) → console log (dev).
# So if you use Resend, do NOT set any SMTP_* var — otherwise SMTP is tried first.
# NEXTAUTH_URL must be set in production so the reset link points at the right host.
#
# Option A (recommended) — Resend HTTPS API. Works on ANY Railway plan (incl. Hobby),
# needs a domain verified in Resend (add its DKIM/SPF DNS records at your DNS provider):
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="Doewe <noreply@your-domain>"        # from-address must be on the verified domain
#
# Option B — Gmail SMTP. NOTE: Railway blocks outbound SMTP on Free/Trial/Hobby —
# this only works on Railway Pro+. Needs 2FA + a 16-char Google App Password:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="xxxxxxxxxxxxxxxx"        # 16-char Google App Password (NOT your normal password)
# EMAIL_FROM="Doewe <you@gmail.com>"