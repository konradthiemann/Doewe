# Copy to .env.local and fill with your own values (never commit .env.local)
# Lokale Docker-DB (docker-compose.yml): User/Pass/DB = doewe/doewe/doewe_local
DATABASE_URL="postgresql://doewe:doewe@localhost:5432/doewe_local"
# Railway (prod) nutzt Reference-Variablen statt fester Werte:
# DATABASE_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Bearer-Token fuer /api/cron/* (isAuthorizedCron in lib/cronAuth.ts)
CRON_SECRET="change-me-to-a-long-random-string"
# Bearer-Token fuer /api/admin/* (isAuthorizedService in lib/serviceAuth.ts),
# gelesen vom Symfony-Control-Plane-Backend
DOEWE_SERVICE_TOKEN="change-me-to-a-long-random-string"
